# 复制为 oss_backup.env 后修改
#   Windows: copy scripts\oss_backup.env.example scripts\oss_backup.env
#   Mac/Linux: cp scripts/oss_backup.env.example scripts/oss_backup.env
#
# Windows 运行（无需 Git Bash）:
#   python scripts\oss_backup_from_csv.py --list
#   python scripts\oss_backup_from_csv.py
#   或双击 scripts\oss_backup_list.bat / oss_backup_from_csv.bat
#
# 路径可用 D:/OSS-backup 或 D:\OSS-backup

# 必填：本地备份根目录（每个 Bucket -> ${OSS_BACKUP_ROOT}/地域/Bucket名/...）
OSS_BACKUP_ROOT=D:/OSS-backup

# Bucket 列表 CSV（控制台导出）
BUCKETS_CSV=C:/Users/你的用户名/Downloads/buckets_20260914.csv

# 阿里云 RAM（也可改用 ossutil config，则此处可留空）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 跳过 tanzania*、th* 等业务桶
EXCLUDE_PREFIXES=tanzania,th

# 跳过归档/冷归档桶（解冻后再备时改为 0）
SKIP_ARCHIVE=1

# 强制跳过的桶名（逗号分隔；默认含两个印度 Archive 备份桶）
EXCLUDE_BUCKETS=loan-core-data-india-sg-bak,india-filess-new-bak

# 小于 1MB 的空桶不下载
MIN_BYTES=1048576

# ossutil 并行任务数（长期跑可适当加大，如 10）
JOBS=5

# 只备份指定 bucket（留空=按 CSV 规则全量）
# ONLY_BUCKETS=ngeria-core-data,ngeria-device-data-2023
